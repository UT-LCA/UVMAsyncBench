include ../../../common/make.config

NVCCCFLAGS = -code=$(SM_ARCH) -arch=$(COMPUTE) -I$(CUPTI_INCLUDE) -L$(CUPTI_LIB_DIR) -std=c++11 -lcuda -lcupti -O3
NVCC = $(CUDA_DIR)/bin/nvcc

EXECUTABLE := gemv
CUFILES := gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp

EXECUTABLE_2 := gemv_2
CUFILES_2:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=2

EXECUTABLE_4 := gemv_4
CUFILES_4:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=4
 
EXECUTABLE_8 := gemv_8
CUFILES_8:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=8

EXECUTABLE_16 := gemv_16
CUFILES_16:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=16

EXECUTABLE_32 := gemv_32
CUFILES_32:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=32

EXECUTABLE_64 := gemv_64
CUFILES_64:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=64

EXECUTABLE_128 := gemv_128
CUFILES_128:= gemv.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=128 -DBATCH_SIZE=128


all:
	$(NVCC) ${NVCCCFLAGS} ${CUFILES} ${DEF} -o ${EXECUTABLE}

	$(NVCC) ${NVCCCFLAGS} ${CUFILES_2} ${DEF} -o ${EXECUTABLE_2}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_4} ${DEF} -o ${EXECUTABLE_4}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_8} ${DEF} -o ${EXECUTABLE_8}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_16} ${DEF} -o ${EXECUTABLE_16}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_32} ${DEF} -o ${EXECUTABLE_32}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_64} ${DEF} -o ${EXECUTABLE_64}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_128} ${DEF} -o ${EXECUTABLE_128}
clean:
	rm -f *.o gemv

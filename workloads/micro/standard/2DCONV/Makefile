include ../../../common/make.config

NVCCCFLAGS = -code=$(SM_ARCH) -arch=$(COMPUTE) -I$(CUPTI_INCLUDE) -L$(CUPTI_LIB_DIR) -std=c++11 -lcuda -lcupti -O3
NVCC = $(CUDA_DIR)/bin/nvcc

EXECUTABLE := 2DConvolution
CUFILES := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp


EXECUTABLE_16384_64 := 2DCONV_16384_64
CUFILES_16384_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=128 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4

EXECUTABLE_4096_64 := 2DCONV_4096_64
CUFILES_4096_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=64 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4

EXECUTABLE_1024_64 := 2DCONV_1024_64
CUFILES_1024_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=32 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4

EXECUTABLE_256_64 := 2DCONV_256_64
CUFILES_256_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=16 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4

EXECUTABLE_64_64 := 2DCONV_64_64
CUFILES_64_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=8 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4



EXECUTABLE_1024_1024 := 2DCONV_1024_1024
CUFILES_1024_1024 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=32 -DDIM_THREAD_BLOCK=32 -DBATCH_SIZE=1

EXECUTABLE_1024_256 := 2DCONV_1024_256
CUFILES_1024_256 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=32 -DDIM_THREAD_BLOCK=16 -DBATCH_SIZE=2

# EXECUTABLE_1024_64 := 2DCONV_1024_64
# CUFILES_1024_64 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=32 -DDIM_THREAD_BLOCK=8 -DBATCH_SIZE=4

EXECUTABLE_1024_16 := 2DCONV_1024_16
CUFILES_1024_16 := 2DConvolution.cu $(CUPTI_ADD_COMMON)/cupti_add.cpp $(CUPTI_ADD_COMMON)/cpu_timestamps.cpp -DSIZE=65536 -DNBLOCK=32 -DDIM_THREAD_BLOCK=4 -DBATCH_SIZE=8


all:
	$(NVCC) ${NVCCCFLAGS} ${CUFILES} ${DEF} -o ${EXECUTABLE}

	$(NVCC) ${NVCCCFLAGS} ${CUFILES_16384_64} ${DEF} -o ${EXECUTABLE_16384_64}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_4096_64} ${DEF} -o ${EXECUTABLE_4096_64}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_1024_64} ${DEF} -o ${EXECUTABLE_1024_64}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_256_64} ${DEF} -o ${EXECUTABLE_256_64}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_64_64} ${DEF} -o ${EXECUTABLE_64_64}

	$(NVCC) ${NVCCCFLAGS} ${CUFILES_1024_1024} ${DEF} -o ${EXECUTABLE_1024_1024}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_1024_256} ${DEF} -o ${EXECUTABLE_1024_256}
	$(NVCC) ${NVCCCFLAGS} ${CUFILES_1024_16} ${DEF} -o ${EXECUTABLE_1024_16}

clean:
	rm -f *.o 2DConvolution
